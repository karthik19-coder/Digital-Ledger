# Supabase Configuration
# Obtain these values from your Supabase Project Settings -> API.
# Note: VITE_SUPABASE_ANON_KEY is safe for client-side use when Row-Level Security (RLS) is enabled.
# NEVER place service_role keys or database passwords in this file or any client-side environment file.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
